{
  "model": {
    "alpha": 1.0,
    "weights_path": null,
    "backbone": {
      "name": "efficientnet_b0",
      "pretrained_weights": "DEFAULT"
    },
    "head": {
      "filters_size": [
        256,
        128,
        64
      ],
      "head_layers": 3,
      "conv_bias": true
    }
  },
  "train": {
    "is_overfit": false,
    "lr": 2e-2,
    "lr_backbone": 1e-2,
    "lr_head": 1e-2,
    "lr_head_pretrain": 1e-2,
    "head_pretrain_epochs": 120,
    "backbone_trainable_params_patterns_include": null,
    "backbone_trainable_params_patterns_exclude": [
      "features.1",
      "features.2",
      "features.3",
      "features.4",
      "features.5"
    ],
    "batch_size": 32,
    "batch_size_val": 16,
    "drop_last": true,
    "subset_len": null,
    "val_subset_len": null,
    "calculate_epoch_loss": true,
    "num_workers": 8,
    "num_workers_validation": 12,
    "persistent_workers": true,
    "save_best_model": true,
    "skip_save_best_model_epochs": 90,
    "warmup_epochs": 0,
    "warmup_rate_scale": 0.01,
    "weight_decay": 0.0004,
    "weight_decay_bias": false,
    "optimizer": "Adam",
    "data_augmentation": {
      "random_flip_horizontal": true,
      "random_resize_crop_scale": [0.5, 1.0],
      "random_resize_crop_ratio": [0.6667, 1.5]
    },
    "lr_schedule": {
      "type": "multi_step",
      "step": {
        "step_size": 1,
        "factor": 0.96,
        "last_epoch": -1
      },
      "multi_step": {
        "milestones": [15, 30],
        "factor": 0.1
      },
      "reduce_on_plato": {
        "patience": 3,
        "factor": 0.1,
        "min_lr": 1e-5
      }
    },
    "stop_criteria": {
      "loss": null,
      "epoch": 175
    }
  },
  "data": {
    "is_download": false,
    "class_amount": 1,
    "train": {
      "images_folder": "../../VOC/VOCdevkit/VOC2007/JPEGImages",
      "ann_file": "../../PASCAL_COCO/pascal_train2007_filtered_15.json"
    },
    "val": {
      "images_folder": "../../VOC/VOCdevkit/VOC2007/JPEGImages",
      "ann_file": "../../PASCAL_COCO/pascal_val2007_filtered_15.json"
    },
    "test": {
      "images_folder": "../../VOC_test/VOCdevkit/VOC2007/JPEGImages",
      "ann_file": "../../PASCAL_COCO/pascal_test2007_filtered_15.json"
    }
  }
}