{
  "model": {
    "alpha": 1.0,
    "weights_path": null,
    "backbone": {
      "name": "efficientnet_b0",
      "pretrained_weights": "DEFAULT"
    },
    "head": {
      "filters_size": [
        128,
        64,
        32
      ]
    }
  },
  "train": {
    "is_overfit": false,
    "lr": 1e-2,
    "batch_size": 64,
    "subset_len": null,
    "val_subset_len": null,
    "calculate_epoch_loss": true,
    "num_workers": 8,    
    "data_augmentation": {
        "random_flip_horizontal": true,
        "random_resize_crop_scale": [0.5, 1.0],
        "random_resize_crop_ratio": [0.6667, 1.5]
    },
    "drop_last": true,
    "lr_schedule": {
        "type": "reduce_on_plato",
        "step": {
          "step_size": 1,
          "factor": 0.96,
          "last_epoch": -1
        },
        "multi_step": {
          "milestones": [50, 80],
          "factor": 0.1
        },
        "reduce_on_plato": {
          "patience": 3,
          "factor": 0.1,
          "min_lr": 1e-5
        }
      },
      "stop_criteria": {
        "loss": null,
        "epoch": 175
      }
    },
      "save_best_model": true,
    "save_best_model_skip_epochs": 20,
    "shuffle": true,
    "stop_criteria": {
      "loss": null,
      "epoch": 150
    }
  },
  "data": {
    "is_download": false,
    "class_amount": 1,
    "train": {
      "images_folder": "../../VOC/VOCdevkit/VOC2007/JPEGImages",
      "ann_file": "../../PASCAL_COCO/pascal_train2007_filtered_15.json"
    },
    "val": {
      "images_folder": "../../VOC/VOCdevkit/VOC2007/JPEGImages",
      "ann_file": "../../PASCAL_COCO/pascal_val2007_filtered_15.json"
    },
    "test": {
      "images_folder": "../../VOC_test/VOCdevkit/VOC2007/JPEGImages",
      "ann_file": "../../PASCAL_COCO/pascal_test2007_filtered_15.json"
    }
  }
}